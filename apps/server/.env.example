# Server
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Redis
REDIS_URL=redis://localhost:6379

# Room lifecycle
ROOM_INACTIVITY_TTL_MS=900000
ROOM_MAX_DURATION_MS=3600000
RECONNECT_WINDOW_MS=30000
SYNC_TICK_HZ=30
CHAT_TTL_MS=3600000

# Rate limiting (room creation)
ROOM_CREATE_RATE_LIMIT_MAX=5
ROOM_CREATE_RATE_LIMIT_WINDOW_MS=600000

# Photos: explicit kill switch (independent of S3_BUCKET) — the client asks
# GET /config and hides the upload UI entirely when this is false.
ENABLE_PHOTOS=true

# Photo storage (S3-compatible: AWS S3 or Cloudflare R2)
# Leave S3_BUCKET empty to disable photo upload (returns 503) — useful for
# running the rest of the app without cloud credentials.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PHOTO_UPLOAD_URL_TTL_SECONDS=300
PHOTO_LIFECYCLE_TTL_MS=600000

# Photo moderation (optional — stub approves everything if unset)
MODERATION_API_URL=
MODERATION_API_KEY=
